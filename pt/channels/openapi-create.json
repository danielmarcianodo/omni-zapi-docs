{
  "openapi": "3.1.0",
  "info": {
    "title": "Omni Z-API - Criar Canal",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.omni.z-api.io"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/v1/channels": {
      "post": {
        "summary": "Criar canal",
        "description": "Cria um novo canal.",
        "operationId": "createChannel",
        "tags": [
          "Canais"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChannelRequest"
              },
              "example": {
                "name": "Meu canal WhatsApp",
                "type": "META_WHATSAPP"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Canal criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateChannelResponse"
                },
                "example": {
                  "id": "019E4C54B1B375A28970B605CA9B03C3"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Nome já usado por outro canal ativo do workspace. A comparação ignora maiúsculas e os espaços das pontas; acento e espaço interno diferenciam. Reconheça pelo campo `error`, que é estável; `message` é sempre em inglês.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChannelNameInUseError"
                },
                "example": {
                  "error": "channel_name_in_use",
                  "message": "A channel with this name already exists in this workspace. Pick another one."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Unauthorized": {
        "description": "Token inválido ou ausente.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": 401,
              "message": "Unauthorized"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateChannelRequest": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome do canal"
          },
          "type": {
            "type": "string",
            "description": "Tipo do canal (plataforma)",
            "enum": [
              "META_WHATSAPP",
              "Z_API_WHATSAPP",
              "META_INSTAGRAM",
              "META_MESSENGER",
              "BOT_TELEGRAM"
            ]
          }
        }
      },
      "CreateChannelResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID do canal criado (channelId)"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ChannelNameInUseError": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "channel_name_in_use"
            ],
            "description": "Código estável da recusa"
          },
          "message": {
            "type": "string",
            "description": "Texto fixo, sempre em inglês"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret Key gerada no painel de Segurança do Omni Z-API"
      }
    }
  }
}
